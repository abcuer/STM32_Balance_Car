   3:Modules/mpu6050/IIC.c **** 
   4:Modules/mpu6050/IIC.c **** /* 定义IIC总线连接的GPIO端口, 用户只需要修改下面4行代码即可任意改变SCL�
   5:Modules/mpu6050/IIC.c **** #define GPIO_PORT_IIC     GPIOB                       /* GPIO端口 */
   6:Modules/mpu6050/IIC.c **** #define RCC_IIC_ENABLE    __HAL_RCC_GPIOB_CLK_ENABLE()       /* GPIO端口时钟 */
   7:Modules/mpu6050/IIC.c **** #define IIC_SCL_PIN       GPIO_PIN_10                  /* 连接到SCL时钟线的GPIO */
   8:Modules/mpu6050/IIC.c **** #define IIC_SDA_PIN       GPIO_PIN_11                  /* 连接到SDA数据线的GPIO */
   9:Modules/mpu6050/IIC.c **** 
  10:Modules/mpu6050/IIC.c **** /* 定义读写SCL和SDA的宏，已增加代码的可移植性和可阅读性 */
  11:Modules/mpu6050/IIC.c **** #if 1	/* 条件编译： 1 选择GPIO的库函数实现IO读写 */
  12:Modules/mpu6050/IIC.c **** #define IIC_SCL_1()  HAL_GPIO_WritePin(GPIO_PORT_IIC, IIC_SCL_PIN, GPIO_PIN_SET)		/* SCL = 1 */
  13:Modules/mpu6050/IIC.c **** #define IIC_SCL_0()  HAL_GPIO_WritePin(GPIO_PORT_IIC, IIC_SCL_PIN, GPIO_PIN_RESET)		/* SCL = 0 */
  14:Modules/mpu6050/IIC.c **** 
  15:Modules/mpu6050/IIC.c **** #define IIC_SDA_1()  HAL_GPIO_WritePin(GPIO_PORT_IIC, IIC_SDA_PIN, GPIO_PIN_SET)		/* SDA = 1 */
  16:Modules/mpu6050/IIC.c **** #define IIC_SDA_0()  HAL_GPIO_WritePin(GPIO_PORT_IIC, IIC_SDA_PIN, GPIO_PIN_RESET)		/* SDA = 0 */
  17:Modules/mpu6050/IIC.c **** 
  18:Modules/mpu6050/IIC.c **** #define IIC_SDA_READ()  HAL_GPIO_ReadPin(GPIO_PORT_IIC, IIC_SDA_PIN)	/* 读SDA口线状态 */
  19:Modules/mpu6050/IIC.c **** #else	/* 这个分支选择直接寄存器操作实现IO读写 */
  20:Modules/mpu6050/IIC.c **** /*　注意：如下写法，在IAR最高级别优化时，会被编译器错误优化 */
  21:Modules/mpu6050/IIC.c **** #define IIC_SCL_1()  GPIO_PORT_IIC->BSRR = IIC_SCL_PIN				/* SCL = 1 */
  22:Modules/mpu6050/IIC.c **** #define IIC_SCL_0()  GPIO_PORT_IIC->BRR = IIC_SCL_PIN				/* SCL = 0 */
  23:Modules/mpu6050/IIC.c **** 
  24:Modules/mpu6050/IIC.c **** #define IIC_SDA_1()  GPIO_PORT_IIC->BSRR = IIC_SDA_PIN				/* SDA = 1 */
  25:Modules/mpu6050/IIC.c **** #define IIC_SDA_0()  GPIO_PORT_IIC->BRR = IIC_SDA_PIN				/* SDA = 0 */
  26:Modules/mpu6050/IIC.c **** 
  27:Modules/mpu6050/IIC.c **** #define IIC_SDA_READ()  ((GPIO_PORT_IIC->IDR & IIC_SDA_PIN) != 0)	/* 读SDA口线状态 */
  28:Modules/mpu6050/IIC.c **** #endif
