  34:Modules/mpu6050/IIC.c **** *	函 数 名: IIC_Delay
  35:Modules/mpu6050/IIC.c **** *	功能说明: IIC总线位延迟，最快400KHz
  36:Modules/mpu6050/IIC.c **** *	形    参：无
  37:Modules/mpu6050/IIC.c **** *	返 回 值: 无
  38:Modules/mpu6050/IIC.c **** ***************************************************************************************************
  39:Modules/mpu6050/IIC.c **** */
  40:Modules/mpu6050/IIC.c **** static void IIC_Delay(void)
  41:Modules/mpu6050/IIC.c **** {
  42:Modules/mpu6050/IIC.c ****     uint8_t i;
  43:Modules/mpu6050/IIC.c **** 
  44:Modules/mpu6050/IIC.c ****     /*　
  45:Modules/mpu6050/IIC.c ****      	下面的时间是通过安富莱AX-Pro逻辑分析仪测试得到的。
  46:Modules/mpu6050/IIC.c ****     	CPU主频72MHz时，在内部Flash运行, MDK工程不优化
  47:Modules/mpu6050/IIC.c ****     	循环次数为10时，SCL频率 = 205KHz
  48:Modules/mpu6050/IIC.c ****     	循环次数为7时，SCL频率 = 347KHz， SCL高电平时间1.5us，SCL低电平时间2.87us
  49:Modules/mpu6050/IIC.c ****      	循环次数为5时，SCL频率 = 421KHz， SCL高电平时间1.25us，SCL低电平时间2.37
  50:Modules/mpu6050/IIC.c **** 
  51:Modules/mpu6050/IIC.c ****     IAR工程编译效率高，不能设置为7
  52:Modules/mpu6050/IIC.c ****     */
  53:Modules/mpu6050/IIC.c ****     for (i = 0; i < 10; i++);
  54:Modules/mpu6050/IIC.c **** }
  55:Modules/mpu6050/IIC.c **** 
