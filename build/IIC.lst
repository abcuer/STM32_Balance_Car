 137:Modules/mpu6050/IIC.c **** uint8_t IIC_Read_Byte(uint8_t ack)
 138:Modules/mpu6050/IIC.c **** {
 139:Modules/mpu6050/IIC.c ****     uint8_t i;
 140:Modules/mpu6050/IIC.c ****     uint8_t value;
 141:Modules/mpu6050/IIC.c **** 
 142:Modules/mpu6050/IIC.c ****     /* 读到第1个bit为数据的bit7 */
 143:Modules/mpu6050/IIC.c ****     value = 0;
 144:Modules/mpu6050/IIC.c ****     for (i = 0; i < 8; i++)
 145:Modules/mpu6050/IIC.c ****     {
 146:Modules/mpu6050/IIC.c ****         value <<= 1;
 147:Modules/mpu6050/IIC.c ****         IIC_SCL_1();
 148:Modules/mpu6050/IIC.c ****         IIC_Delay();
 149:Modules/mpu6050/IIC.c ****         if (IIC_SDA_READ())
 150:Modules/mpu6050/IIC.c ****         {
 151:Modules/mpu6050/IIC.c ****             value++;
 152:Modules/mpu6050/IIC.c ****         }
 153:Modules/mpu6050/IIC.c ****         IIC_SCL_0();
 154:Modules/mpu6050/IIC.c ****         IIC_Delay();
 155:Modules/mpu6050/IIC.c ****     }
 156:Modules/mpu6050/IIC.c ****     if(ack==0)
 157:Modules/mpu6050/IIC.c ****         IIC_NAck();
 158:Modules/mpu6050/IIC.c ****     else
 159:Modules/mpu6050/IIC.c ****         IIC_Ack();
 160:Modules/mpu6050/IIC.c ****     return value;
 161:Modules/mpu6050/IIC.c **** }
