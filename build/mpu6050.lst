  47:Modules/mpu6050/mpu6050.c **** //设置MPU6050的数字低通滤波器
  48:Modules/mpu6050/mpu6050.c **** //lpf:数字低通滤波频率(Hz)
  49:Modules/mpu6050/mpu6050.c **** //返回值:0,设置成功
  50:Modules/mpu6050/mpu6050.c **** //    其他,设置失败
  51:Modules/mpu6050/mpu6050.c **** uint8_t MPU_Set_LPF(uint16_t lpf)
  52:Modules/mpu6050/mpu6050.c **** {
  53:Modules/mpu6050/mpu6050.c ****     uint8_t data=0;
  54:Modules/mpu6050/mpu6050.c ****     if(lpf>=188)data=1;
  55:Modules/mpu6050/mpu6050.c ****     else if(lpf>=98)data=2;
  56:Modules/mpu6050/mpu6050.c ****     else if(lpf>=42)data=3;
  57:Modules/mpu6050/mpu6050.c ****     else if(lpf>=20)data=4;
  58:Modules/mpu6050/mpu6050.c ****     else if(lpf>=10)data=5;
  59:Modules/mpu6050/mpu6050.c ****     else data=6;
  60:Modules/mpu6050/mpu6050.c ****     return MPU_Write_Byte(MPU_CFG_REG,data);//设置数字低通滤波器
  61:Modules/mpu6050/mpu6050.c **** }
  62:Modules/mpu6050/mpu6050.c **** //设置MPU6050的采样率(假定Fs=1KHz)
  63:Modules/mpu6050/mpu6050.c **** //rate:4~1000(Hz)
  64:Modules/mpu6050/mpu6050.c **** //返回值:0,设置成功
  65:Modules/mpu6050/mpu6050.c **** //    其他,设置失败
  66:Modules/mpu6050/mpu6050.c **** uint8_t MPU_Set_Rate(uint16_t rate)
  67:Modules/mpu6050/mpu6050.c **** {
  68:Modules/mpu6050/mpu6050.c ****     uint8_t data;
  69:Modules/mpu6050/mpu6050.c ****     if(rate>1000)rate=1000;
  70:Modules/mpu6050/mpu6050.c ****     if(rate<4)rate=4;
  71:Modules/mpu6050/mpu6050.c ****     data=1000/rate-1;
  72:Modules/mpu6050/mpu6050.c ****     data=MPU_Write_Byte(MPU_SAMPLE_RATE_REG,data);	//设置数字低通滤波器
  73:Modules/mpu6050/mpu6050.c ****     return MPU_Set_LPF(rate/2);	//自动设置LPF为采样率的一半
  74:Modules/mpu6050/mpu6050.c **** }
  75:Modules/mpu6050/mpu6050.c **** 
  76:Modules/mpu6050/mpu6050.c **** //得到温度值
  77:Modules/mpu6050/mpu6050.c **** //返回值:温度值(扩大了100倍)
  78:Modules/mpu6050/mpu6050.c **** short MPU_Get_Temperature(void)
  79:Modules/mpu6050/mpu6050.c **** {
  80:Modules/mpu6050/mpu6050.c ****     uint8_t buf[2];
  81:Modules/mpu6050/mpu6050.c ****     short raw;
