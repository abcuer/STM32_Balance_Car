  84:Modules/mpu6050/mpu6050.c ****     raw=((uint16_t)buf[0]<<8)|buf[1];
  85:Modules/mpu6050/mpu6050.c ****     temp=36.53+((double)raw)/340;
  86:Modules/mpu6050/mpu6050.c ****     return temp*100;;
  87:Modules/mpu6050/mpu6050.c **** }
