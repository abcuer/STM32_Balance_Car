 532:Modules/mpu6050/inv_mpu_dmp_motion_driver.c ****     const unsigned char accel_sign[3] = {DINA26, DINA46, DINA66};
 533:Modules/mpu6050/inv_mpu_dmp_motion_driver.c **** 
 534:Modules/mpu6050/inv_mpu_dmp_motion_driver.c ****     gyro_regs[0] = gyro_axes[orient & 3];
 535:Modules/mpu6050/inv_mpu_dmp_motion_driver.c ****     gyro_regs[1] = gyro_axes[(orient >> 3) & 3];
 536:Modules/mpu6050/inv_mpu_dmp_motion_driver.c ****     gyro_regs[2] = gyro_axes[(orient >> 6) & 3];
 537:Modules/mpu6050/inv_mpu_dmp_motion_driver.c ****     accel_regs[0] = accel_axes[orient & 3];
