1140:Modules/mpu6050/inv_mpu_dmp_motion_driver.c ****     } else {
1141:Modules/mpu6050/inv_mpu_dmp_motion_driver.c ****         unsigned char regs[9] = {0xb8, 0xaa, 0xaa, 0xaa, 0xb0, 0x88, 0xc3, 0xc5, 0xc7};
1142:Modules/mpu6050/inv_mpu_dmp_motion_driver.c ****         return mpu_write_mem(CFG_MOTION_BIAS, 9, regs);
1143:Modules/mpu6050/inv_mpu_dmp_motion_driver.c ****     }
1144:Modules/mpu6050/inv_mpu_dmp_motion_driver.c **** }
