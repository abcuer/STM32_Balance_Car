 922:Modules/mpu6050/inv_mpu.c ****         tmp[1] = INV_LPA_5HZ;
 923:Modules/mpu6050/inv_mpu.c ****         mpu_set_lpf(5);
 924:Modules/mpu6050/inv_mpu.c ****     } else if (rate <= 20) {
 925:Modules/mpu6050/inv_mpu.c ****         tmp[1] = INV_LPA_20HZ;
 926:Modules/mpu6050/inv_mpu.c ****         mpu_set_lpf(10);
 927:Modules/mpu6050/inv_mpu.c ****     } else {
 928:Modules/mpu6050/inv_mpu.c ****         tmp[1] = INV_LPA_40HZ;
 929:Modules/mpu6050/inv_mpu.c ****         mpu_set_lpf(20);
 930:Modules/mpu6050/inv_mpu.c ****     }
