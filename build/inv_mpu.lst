 678:Modules/mpu6050/inv_mpu.c **** /**
 679:Modules/mpu6050/inv_mpu.c ****  *  @brief      Enable/disable data ready interrupt.
 680:Modules/mpu6050/inv_mpu.c ****  *  If the DMP is on, the DMP interrupt is enabled. Otherwise, the data ready
 681:Modules/mpu6050/inv_mpu.c ****  *  interrupt is used.
 682:Modules/mpu6050/inv_mpu.c ****  *  @param[in]  enable      1 to enable interrupt.
 683:Modules/mpu6050/inv_mpu.c ****  *  @return     0 if successful.
 684:Modules/mpu6050/inv_mpu.c ****  */
 685:Modules/mpu6050/inv_mpu.c **** static int set_int_enable(unsigned char enable)
 686:Modules/mpu6050/inv_mpu.c **** {
 687:Modules/mpu6050/inv_mpu.c ****     unsigned char tmp;
 688:Modules/mpu6050/inv_mpu.c **** 
 689:Modules/mpu6050/inv_mpu.c ****     if (st.chip_cfg.dmp_on) {
 690:Modules/mpu6050/inv_mpu.c ****         if (enable)
 691:Modules/mpu6050/inv_mpu.c ****             tmp = BIT_DMP_INT_EN;
 692:Modules/mpu6050/inv_mpu.c ****         else
 693:Modules/mpu6050/inv_mpu.c ****             tmp = 0x00;
 694:Modules/mpu6050/inv_mpu.c ****         if (i2c_write(st.hw->addr, st.reg->int_enable, 1, &tmp))
 695:Modules/mpu6050/inv_mpu.c ****             return -1;
 696:Modules/mpu6050/inv_mpu.c ****         st.chip_cfg.int_enable = tmp;
 697:Modules/mpu6050/inv_mpu.c ****     } else {
 698:Modules/mpu6050/inv_mpu.c ****         if (!st.chip_cfg.sensors)
 699:Modules/mpu6050/inv_mpu.c ****             return -1;
 700:Modules/mpu6050/inv_mpu.c ****         if (enable && st.chip_cfg.int_enable)
 701:Modules/mpu6050/inv_mpu.c ****             return 0;
 702:Modules/mpu6050/inv_mpu.c ****         if (enable)
 703:Modules/mpu6050/inv_mpu.c ****             tmp = BIT_DATA_RDY_EN;
 704:Modules/mpu6050/inv_mpu.c ****         else
 705:Modules/mpu6050/inv_mpu.c ****             tmp = 0x00;
 706:Modules/mpu6050/inv_mpu.c ****         if (i2c_write(st.hw->addr, st.reg->int_enable, 1, &tmp))
 707:Modules/mpu6050/inv_mpu.c ****             return -1;
 708:Modules/mpu6050/inv_mpu.c ****         st.chip_cfg.int_enable = tmp;
 709:Modules/mpu6050/inv_mpu.c ****     }
 710:Modules/mpu6050/inv_mpu.c ****     return 0;
 711:Modules/mpu6050/inv_mpu.c **** }
