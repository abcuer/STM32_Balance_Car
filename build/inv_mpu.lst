 898:Modules/mpu6050/inv_mpu.c **** 
 899:Modules/mpu6050/inv_mpu.c ****     if (!rate) {
 900:Modules/mpu6050/inv_mpu.c ****         mpu_set_int_latched(0);
 901:Modules/mpu6050/inv_mpu.c ****         tmp[0] = 0;
 902:Modules/mpu6050/inv_mpu.c ****         tmp[1] = BIT_STBY_XYZG;
