 774:Modules/mpu6050/inv_mpu.c ****         return -1;
 775:Modules/mpu6050/inv_mpu.c **** 
 776:Modules/mpu6050/inv_mpu.c **** #if defined MPU6050
 777:Modules/mpu6050/inv_mpu.c ****     /* Check product revision. */
