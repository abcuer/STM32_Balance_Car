2153:Modules/mpu6050/inv_mpu.c **** /**
2154:Modules/mpu6050/inv_mpu.c ****  *  @brief      Trigger gyro/accel/compass self-test.
ARM GAS  C:\Users\FASCIN~1\AppData\Local\Temp\ccNBUjvk.s 			page 173


2155:Modules/mpu6050/inv_mpu.c ****  *  On success/error, the self-test returns a mask representing the sensor(s)
2156:Modules/mpu6050/inv_mpu.c ****  *  that failed. For each bit, a one (1) represents a "pass" case; conversely,
2157:Modules/mpu6050/inv_mpu.c ****  *  a zero (0) indicates a failure.
2158:Modules/mpu6050/inv_mpu.c ****  *
2159:Modules/mpu6050/inv_mpu.c ****  *  \n The mask is defined as follows:
2160:Modules/mpu6050/inv_mpu.c ****  *  \n Bit 0:   Gyro.
2161:Modules/mpu6050/inv_mpu.c ****  *  \n Bit 1:   Accel.
2162:Modules/mpu6050/inv_mpu.c ****  *  \n Bit 2:   Compass.
2163:Modules/mpu6050/inv_mpu.c ****  *
2164:Modules/mpu6050/inv_mpu.c ****  *  \n Currently, the hardware self-test is unsupported for MPU6500. However,
2165:Modules/mpu6050/inv_mpu.c ****  *  this function can still be used to obtain the accel and gyro biases.
2166:Modules/mpu6050/inv_mpu.c ****  *
2167:Modules/mpu6050/inv_mpu.c ****  *  \n This function must be called with the device either face-up or face-down
2168:Modules/mpu6050/inv_mpu.c ****  *  (z-axis is parallel to gravity).
2169:Modules/mpu6050/inv_mpu.c ****  *  @param[out] gyro        Gyro biases in q16 format.
2170:Modules/mpu6050/inv_mpu.c ****  *  @param[out] accel       Accel biases (if applicable) in q16 format.
2171:Modules/mpu6050/inv_mpu.c ****  *  @return     Result mask (see above).
2172:Modules/mpu6050/inv_mpu.c ****  */
2173:Modules/mpu6050/inv_mpu.c **** int mpu_run_self_test(long *gyro, long *accel)
2174:Modules/mpu6050/inv_mpu.c **** {
2175:Modules/mpu6050/inv_mpu.c **** #ifdef MPU6050
2176:Modules/mpu6050/inv_mpu.c ****     const unsigned char tries = 2;
2177:Modules/mpu6050/inv_mpu.c ****     long gyro_st[3], accel_st[3];
2178:Modules/mpu6050/inv_mpu.c ****     unsigned char accel_result, gyro_result;
2179:Modules/mpu6050/inv_mpu.c **** #ifdef AK89xx_SECONDARY
2180:Modules/mpu6050/inv_mpu.c ****     unsigned char compass_result;
2181:Modules/mpu6050/inv_mpu.c **** #endif
2182:Modules/mpu6050/inv_mpu.c ****     int ii;
2183:Modules/mpu6050/inv_mpu.c **** #endif
2184:Modules/mpu6050/inv_mpu.c ****     int result;
2185:Modules/mpu6050/inv_mpu.c ****     unsigned char accel_fsr, fifo_sensors, sensors_on;
2186:Modules/mpu6050/inv_mpu.c ****     unsigned short gyro_fsr, sample_rate, lpf;
2187:Modules/mpu6050/inv_mpu.c ****     unsigned char dmp_was_on;
2188:Modules/mpu6050/inv_mpu.c **** 
2189:Modules/mpu6050/inv_mpu.c ****     if (st.chip_cfg.dmp_on) {
2190:Modules/mpu6050/inv_mpu.c ****         mpu_set_dmp_state(0);
2191:Modules/mpu6050/inv_mpu.c ****         dmp_was_on = 1;
2192:Modules/mpu6050/inv_mpu.c ****     } else
2193:Modules/mpu6050/inv_mpu.c ****         dmp_was_on = 0;
2194:Modules/mpu6050/inv_mpu.c **** 
2195:Modules/mpu6050/inv_mpu.c ****     /* Get initial settings. */
2196:Modules/mpu6050/inv_mpu.c ****     mpu_get_gyro_fsr(&gyro_fsr);
2197:Modules/mpu6050/inv_mpu.c ****     mpu_get_accel_fsr(&accel_fsr);
2198:Modules/mpu6050/inv_mpu.c ****     mpu_get_lpf(&lpf);
2199:Modules/mpu6050/inv_mpu.c ****     mpu_get_sample_rate(&sample_rate);
2200:Modules/mpu6050/inv_mpu.c ****     sensors_on = st.chip_cfg.sensors;
2201:Modules/mpu6050/inv_mpu.c ****     mpu_get_fifo_config(&fifo_sensors);
2202:Modules/mpu6050/inv_mpu.c **** 
2203:Modules/mpu6050/inv_mpu.c ****     /* For older chips, the self-test will be different. */
2204:Modules/mpu6050/inv_mpu.c **** #if defined MPU6050
2205:Modules/mpu6050/inv_mpu.c ****     for (ii = 0; ii < tries; ii++)
2206:Modules/mpu6050/inv_mpu.c ****         if (!get_st_biases(gyro, accel, 0))
2207:Modules/mpu6050/inv_mpu.c ****             break;
2208:Modules/mpu6050/inv_mpu.c ****     if (ii == tries) {
2209:Modules/mpu6050/inv_mpu.c ****         /* If we reach this point, we most likely encountered an I2C error.
2210:Modules/mpu6050/inv_mpu.c ****          * We'll just report an error for all three sensors.
2211:Modules/mpu6050/inv_mpu.c ****          */
ARM GAS  C:\Users\FASCIN~1\AppData\Local\Temp\ccNBUjvk.s 			page 174


2212:Modules/mpu6050/inv_mpu.c ****         result = 0;
2213:Modules/mpu6050/inv_mpu.c ****         goto restore;
2214:Modules/mpu6050/inv_mpu.c ****     }
2215:Modules/mpu6050/inv_mpu.c ****     for (ii = 0; ii < tries; ii++)
2216:Modules/mpu6050/inv_mpu.c ****         if (!get_st_biases(gyro_st, accel_st, 1))
2217:Modules/mpu6050/inv_mpu.c ****             break;
2218:Modules/mpu6050/inv_mpu.c ****     if (ii == tries) {
2219:Modules/mpu6050/inv_mpu.c ****         /* Again, probably an I2C error. */
2220:Modules/mpu6050/inv_mpu.c ****         result = 0;
2221:Modules/mpu6050/inv_mpu.c ****         goto restore;
2222:Modules/mpu6050/inv_mpu.c ****     }
2223:Modules/mpu6050/inv_mpu.c ****     accel_result = accel_self_test(accel, accel_st);
2224:Modules/mpu6050/inv_mpu.c ****     gyro_result = gyro_self_test(gyro, gyro_st);
2225:Modules/mpu6050/inv_mpu.c **** 
2226:Modules/mpu6050/inv_mpu.c ****     result = 0;
2227:Modules/mpu6050/inv_mpu.c ****     if (!gyro_result)
2228:Modules/mpu6050/inv_mpu.c ****         result |= 0x01;
2229:Modules/mpu6050/inv_mpu.c ****     if (!accel_result)
2230:Modules/mpu6050/inv_mpu.c ****         result |= 0x02;
2231:Modules/mpu6050/inv_mpu.c **** 
2232:Modules/mpu6050/inv_mpu.c **** #ifdef AK89xx_SECONDARY
2233:Modules/mpu6050/inv_mpu.c ****     compass_result = compass_self_test();
2234:Modules/mpu6050/inv_mpu.c ****     if (!compass_result)
2235:Modules/mpu6050/inv_mpu.c ****         result |= 0x04;
2236:Modules/mpu6050/inv_mpu.c **** #endif
2237:Modules/mpu6050/inv_mpu.c **** restore:
2238:Modules/mpu6050/inv_mpu.c **** #elif defined MPU6500
2239:Modules/mpu6050/inv_mpu.c ****     /* For now, this function will return a "pass" result for all three sensors
2240:Modules/mpu6050/inv_mpu.c ****      * for compatibility with current test applications.
2241:Modules/mpu6050/inv_mpu.c ****      */
2242:Modules/mpu6050/inv_mpu.c ****     get_st_biases(gyro, accel, 0);
2243:Modules/mpu6050/inv_mpu.c ****     result = 0x7;
2244:Modules/mpu6050/inv_mpu.c **** #endif
2245:Modules/mpu6050/inv_mpu.c ****     /* Set to invalid values to ensure no I2C writes are skipped. */
2246:Modules/mpu6050/inv_mpu.c ****     st.chip_cfg.gyro_fsr = 0xFF;
2247:Modules/mpu6050/inv_mpu.c ****     st.chip_cfg.accel_fsr = 0xFF;
2248:Modules/mpu6050/inv_mpu.c ****     st.chip_cfg.lpf = 0xFF;
2249:Modules/mpu6050/inv_mpu.c ****     st.chip_cfg.sample_rate = 0xFFFF;
2250:Modules/mpu6050/inv_mpu.c ****     st.chip_cfg.sensors = 0xFF;
2251:Modules/mpu6050/inv_mpu.c ****     st.chip_cfg.fifo_enable = 0xFF;
2252:Modules/mpu6050/inv_mpu.c ****     st.chip_cfg.clk_src = INV_CLK_PLL;
2253:Modules/mpu6050/inv_mpu.c ****     mpu_set_gyro_fsr(gyro_fsr);
2254:Modules/mpu6050/inv_mpu.c ****     mpu_set_accel_fsr(accel_fsr);
2255:Modules/mpu6050/inv_mpu.c ****     mpu_set_lpf(lpf);
2256:Modules/mpu6050/inv_mpu.c ****     mpu_set_sample_rate(sample_rate);
2257:Modules/mpu6050/inv_mpu.c ****     mpu_set_sensors(sensors_on);
2258:Modules/mpu6050/inv_mpu.c ****     mpu_configure_fifo(fifo_sensors);
2259:Modules/mpu6050/inv_mpu.c **** 
2260:Modules/mpu6050/inv_mpu.c ****     if (dmp_was_on)
2261:Modules/mpu6050/inv_mpu.c ****         mpu_set_dmp_state(1);
2262:Modules/mpu6050/inv_mpu.c **** 
2263:Modules/mpu6050/inv_mpu.c ****     return result;
2264:Modules/mpu6050/inv_mpu.c **** }
