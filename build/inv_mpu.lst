 945:Modules/mpu6050/inv_mpu.c ****         tmp[0] = INV_LPA_20HZ;
 946:Modules/mpu6050/inv_mpu.c ****     else if (rate <= 40)
 947:Modules/mpu6050/inv_mpu.c ****         tmp[0] = INV_LPA_40HZ;
 948:Modules/mpu6050/inv_mpu.c ****     else if (rate <= 80)
