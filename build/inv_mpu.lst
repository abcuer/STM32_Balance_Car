2892:Modules/mpu6050/inv_mpu.c **** //陀螺仪方向控制
2893:Modules/mpu6050/inv_mpu.c **** unsigned short inv_orientation_matrix_to_scalar(
2894:Modules/mpu6050/inv_mpu.c ****     const signed char *mtx)
2895:Modules/mpu6050/inv_mpu.c **** {
2896:Modules/mpu6050/inv_mpu.c ****     unsigned short scalar;
2897:Modules/mpu6050/inv_mpu.c ****     /*
2898:Modules/mpu6050/inv_mpu.c ****        XYZ  010_001_000 Identity Matrix
2899:Modules/mpu6050/inv_mpu.c ****        XZY  001_010_000
2900:Modules/mpu6050/inv_mpu.c ****        YXZ  010_000_001
2901:Modules/mpu6050/inv_mpu.c ****        YZX  000_010_001
2902:Modules/mpu6050/inv_mpu.c ****        ZXY  001_000_010
2903:Modules/mpu6050/inv_mpu.c ****        ZYX  000_001_010
2904:Modules/mpu6050/inv_mpu.c ****      */
2905:Modules/mpu6050/inv_mpu.c **** 
2906:Modules/mpu6050/inv_mpu.c ****     scalar = inv_row_2_scale(mtx);
2907:Modules/mpu6050/inv_mpu.c ****     scalar |= inv_row_2_scale(mtx + 3) << 3;
2908:Modules/mpu6050/inv_mpu.c ****     scalar |= inv_row_2_scale(mtx + 6) << 6;
2909:Modules/mpu6050/inv_mpu.c **** 
2910:Modules/mpu6050/inv_mpu.c **** 
2911:Modules/mpu6050/inv_mpu.c ****     return scalar;
2912:Modules/mpu6050/inv_mpu.c **** }
